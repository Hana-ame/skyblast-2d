{
  "name": "skyblast-2d",
  "version": "0.2.0",
  "description": "SkyBlast 2D — 环形大世界 2D 横版 PVP（Teeworlds 风格底座 + 服务器权威三层架构）",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.ts",
    "build:site": "node scripts/build-site.ts",
    "build:tune": "esbuild src/web/main-proto.ts --bundle --format=iife --outfile=docs/tune-bundle.js",
    "build:editor": "esbuild src/web/main-editor.ts --bundle --format=iife --outfile=docs/editor-bundle.js",
    "build:admin": "esbuild src/web/main-admin.ts --bundle --format=iife --outfile=docs/admin-bundle.js",
    "check": "tsc --noEmit && node --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
